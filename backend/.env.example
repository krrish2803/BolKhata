# Server Configuration
ENV=dev
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# Database (MongoDB Atlas connection string)
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/bolkhata?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/bolkhata_dev
DATABASE_NAME=bolkhata

# LLM Configuration (Google Gemini)
# Do NOT hardcode the model name. Set via GEMINI_MODEL.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_CALL_CAP=500
